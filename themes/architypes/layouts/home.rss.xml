{{- printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>{{ site.Title }}</title>
    <link>{{ site.BaseURL }}</link>
    <description>{{ with site.Params.description }}{{ . }}{{ else }}Recent content on {{ site.Title }}{{ end }}</description>
    <language>{{ site.Language.LanguageCode | default site.Language.Lang }}</language>
    <atom:link href="{{ "/index.xml" | absURL }}" rel="self" type="application/rss+xml" />
    {{ $posts := where site.RegularPages "Section" "posts" }}
    {{ range first 24 $posts }}
    <item>
      <title>{{ .Title }}</title>
      <link>{{ .Permalink }}</link>
      <pubDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</pubDate>
      <guid>{{ .Permalink }}</guid>
      <description>
      	{{ .Content | html }}
      	&lt;img src="https://tinylytics.app/pixel/bUqbbv9aC4svM35xagZs.gif?path={{ .RelPermalink | html }}" alt="" style="width:1px;height:1px;border:0;" /&gt;
      </description>
    </item>
    {{ end }}
  </channel>
</rss>
